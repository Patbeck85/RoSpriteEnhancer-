<Window x:Class="RoSpriteEnhancer.Views.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/microsoft.com/2006/xaml"
        xmlns:local="clr-namespace:RoSpriteEnhancer"
        Title="Einstellungen — RO Sprite Enhancer"
        Height="760" Width="900"
        MinHeight="700" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushGlassBackground}"
        FontFamily="Segoe UI Variable"
        Style="{StaticResource GlassWindow}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushGlassTextDark}"/>
        </Style>
        <Style TargetType="Separator" BasedOn="{StaticResource GlassSeparator}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TABS -->
        <TabControl Grid.Row="0" Margin="12,12,12,0" Background="{StaticResource BrushGlassSurfaceLight}"
                    BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Foreground" Value="{StaticResource BrushGlassTextDark}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="14,6"/>
                    <Setter Property="Background" Value="{StaticResource BrushGlassSurfaceLight}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BrushGlassBorder}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8,8,0,0">
                                    <ContentPresenter x:Name="ContentSource"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushGlassPrimary}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource BrushGlassPrimaryLight}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: ALLGEMEIN -->
            <TabItem Header="⚙ Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel Margin="14,14,14,14">

                        <!-- PRESETS -->
                        <TextBlock Text="💾 PRESETS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbPresets" Grid.Column="0" Style="{StaticResource GlassComboBox}" Margin="0,0,3,0" SelectionChanged="CmbPresets_SelectionChanged"/>
                            <Button x:Name="BtnDeletePreset" Grid.Column="1" Content="🗑" Style="{StaticResource GlassButtonSecondary}" FontSize="12" Padding="0" Click="BtnDeletePreset_Click"/>
                            <Button x:Name="BtnExportPreset" Grid.Column="2" Content="📤" Style="{StaticResource GlassButtonSecondary}" FontSize="12" Padding="0" Click="BtnExportPreset_Click"/>
                            <Button x:Name="BtnImportPreset" Grid.Column="3" Content="📥" Style="{StaticResource GlassButtonSecondary}" FontSize="12" Padding="0" Click="BtnImportPreset_Click"/>
                            <Button x:Name="BtnCloudUploadPreset" Grid.Column="4" Content="☁↑" Style="{StaticResource GlassButtonSecondary}" FontSize="12" Padding="0" Click="BtnCloudUploadPreset_Click"/>
                            <Button x:Name="BtnCloudDownloadPreset" Grid.Column="5" Content="☁↓" Style="{StaticResource GlassButtonSecondary}" FontSize="12" Padding="0" Click="BtnCloudDownloadPreset_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPresetName" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas"/>
                            <Button x:Name="BtnSavePreset" Grid.Column="1" Content="Speichern" Style="{StaticResource GlassButtonSecondary}" Margin="3,0,0,0" FontSize="10" Click="BtnSavePreset_Click"/>
                        </Grid>

                        <!-- TASTATURKÜRZEL -->
                        <TextBlock Text="⌨ TASTATURKÜRZEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,16,0,8"/>
                        <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="Kürzel bearbeiten und mit Enter bestätigen:" FontSize="9" Foreground="{StaticResource BrushGlassTextLight}" FontStyle="Italic" Margin="0,0,0,6"/>
                                <ListBox x:Name="LstShortcuts" Style="{StaticResource GlassListBox}" MaxHeight="200" Margin="0,0,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{StaticResource BrushGlassTextDark}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding DisplayText}" FontSize="10" Foreground="{StaticResource BrushGlassPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ComboBox x:Name="CmbShortcutKey" Grid.Column="1" Style="{StaticResource GlassComboBox}" Width="60" FontSize="9" SelectionChanged="CmbShortcutKey_SelectionChanged" Tag="{Binding CommandName}" Loaded="CmbShortcutKey_Loaded"/>
                                                <ComboBox x:Name="CmbShortcutModifiers" Grid.Column="2" Style="{StaticResource GlassComboBox}" Width="100" FontSize="9" SelectionChanged="CmbShortcutModifiers_SelectionChanged" Tag="{Binding CommandName}" Loaded="CmbShortcutModifiers_Loaded"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="Kürzel werden in %AppData%\RoSpriteEnhancer\keyboardshortcuts.json gespeichert" FontSize="8" Foreground="{StaticResource BrushGlassTextLight}" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- DARK MODE -->
                        <TextBlock Text="🌓 DESIGN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,16,0,8"/>
                        <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkDarkMode" Content="Dark Mode" Style="{StaticResource GlassCheckBox}" FontSize="11" Margin="0,0,0,0" Checked="ChkDarkMode_Checked" Unchecked="ChkDarkMode_Unchecked"/>
                                <TextBlock Text="Wechselt zwischen hellem und dunklem Design" FontSize="9" Foreground="{StaticResource BrushGlassTextLight}" FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- GITHUB TOKEN -->
                        <TextBlock Text="☁ GITHUB GISTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,16,0,8"/>
                        <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="GitHub Personal Access Token:" FontSize="10" Foreground="{StaticResource BrushGlassTextDark}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtGitHubToken" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,6" FontSize="10" FontFamily="Consolas" MaxLength="100"/>
                                <TextBlock Text="Für Preset-Upload zu GitHub Gists. Token mit 'gist' Scope erstellen." FontSize="8" Foreground="{StaticResource BrushGlassTextLight}" FontStyle="Italic" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Separator/>

                        <!-- ORDNER -->
                        <TextBlock Text="📁 ORDNER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <TextBlock Text="Eingabe:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInputPath" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseInput" Grid.Column="1" Content="…" Style="{StaticResource GlassButtonSecondary}" Margin="3,0,0,0" Click="BtnBrowseInput_Click" FontSize="14" Padding="0"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbRecentInputs" Style="{StaticResource GlassComboBox}" Margin="0,0,3,0" FontSize="9" SelectionChanged="CmbRecentInput_SelectionChanged"/>
                            <Button x:Name="BtnClearRecentInputs" Grid.Column="1" Content="×" Style="{StaticResource GlassButtonSecondary}" Margin="3,0,0,0" FontSize="10" Padding="0" Click="BtnClearRecentInputs_Click"/>
                        </Grid>
                        <TextBlock Text="Ausgabe:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputPath" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" IsReadOnly="True"/>
                                <Button x:Name="BtnBrowseOutput" Grid.Column="1" Content="…" Style="{StaticResource GlassButtonSecondary}" Margin="3,0,0,0" Click="BtnBrowseOutput_Click" FontSize="14" Padding="0"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbRecentOutputs" Style="{StaticResource GlassComboBox}" Margin="0,0,3,0" FontSize="9" SelectionChanged="CmbRecentOutput_SelectionChanged"/>
                                <Button x:Name="BtnClearRecentOutputs" Grid.Column="1" Content="×" Style="{StaticResource GlassButtonSecondary}" Margin="3,0,0,0" FontSize="10" Padding="0" Click="BtnClearRecentOutputs_Click"/>
                            </Grid>

                        <Separator/>

                        <!-- DATEITYPEN -->
                        <TextBlock Text="📋 DATEITYPEN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkFilterBmp" Content="BMP" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkFilterPng" Content="PNG" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkFilterTga" Content="TGA" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkFilterSpr" Content="SPR  (RO Animations)" Style="{StaticResource GlassCheckBox}" IsChecked="True" Margin="0,4,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                        <CheckBox x:Name="ChkSubfolders" Content="Unterordner durchsuchen" Style="{StaticResource GlassCheckBox}" IsChecked="True" Margin="0,6,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                        <Separator/>

                        <!-- AUSGABEFORMAT -->
                        <TextBlock Text="💾 AUSGABEFORMAT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbOutputFormat" Style="{StaticResource GlassComboBox}" Margin="0,0,0,4" SelectionChanged="CmbOutputFormat_Changed">
                            <ComboBoxItem Content="PNG  (32-bit Alpha)" IsSelected="True"/>
                            <ComboBoxItem Content="BMP  (Magenta Colorkey)"/>
                            <ComboBoxItem Content="BMP  (8-bit Palette)"/>
                        </ComboBox>
                        <TextBlock x:Name="TxtFormatHint" Text="PNG: empfohlen, volle Qualität" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- INKREMENTELL -->
                        <Separator/>
                        <TextBlock Text="⚡ INKREMENTELL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkIncrementalMode" Content="Nur geänderte Dateien verarbeiten (MD5-Cache)" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <Separator/>

                        <!-- MAGENTA COLORKEY -->
                        <TextBlock Text="🎨 MAGENTA COLORKEY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkMagenta" Content="Magenta-Handling" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="Alpha-Schwellwert:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,6,0,3"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrAlphaThreshold" Minimum="1" Maximum="254" Value="128" Background="{StaticResource BrushGlassBorder}" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtAlphaVal" Text="128" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- SPRACHE -->
                        <Separator/>
                        <TextBlock Text="🌍 SPRACHE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sprache" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="CmbLanguage" Style="{StaticResource GlassComboBox}" SelectionChanged="CmbLanguage_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: SKALIERUNG & KI -->
            <TabItem Header="🔍 Skalierung &amp; KI">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel Margin="14,14,14,14">

                        <!-- SKALIERUNG -->
                        <TextBlock Text="🔍 SKALIERUNG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="CmbScale" Style="{StaticResource GlassComboBox}" Margin="0,0,0,4" SelectionChanged="CmbScale_SelectionChanged">
                            <ComboBoxItem Content="Scale2x    (schnell, pixelig-scharf)" IsSelected="True"/>
                            <ComboBoxItem Content="Scale4x    (4x Scale2x, sehr langsam)"/>
                            <ComboBoxItem Content="xBRZ 2x    (glattere Diagonalen — empfohlen)"/>
                            <ComboBoxItem Content="xBRZ 4x    (höchste Qualität)"/>
                            <ComboBoxItem Content="ESRGAN (extern, Beta)"/>
                            <ComboBoxItem Content="Waifu2x Anime AI (2x Look)"/>
                            <ComboBoxItem Content="Waifu4x Anime AI (4x Ultra-HD Look)"/>
                            <ComboBoxItem Content="RealCUGAN Anime 2x (Profi-Remastering)"/>
                            <ComboBoxItem Content="RealCUGAN Anime 4x (Profi-Remastering 4x)"/>
                            <ComboBoxItem Content="AI-First + High-Res Shading (BESTE 3D-Optik)"/>
                            <ComboBoxItem Content="RealESRGAN — Beste Anime-Qualität mit x4plus-Modell"/>
                            <ComboBoxItem Content="GFPGAN — Gesicht &amp; Haar-Restaurierung für Details"/>
                        </ComboBox>
                        <TextBlock x:Name="TxtScaleHint" Text="Scale2x — schnell, ideal für alte Hardware" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- ESRGAN -->
                        <StackPanel x:Name="PanelEsrganSettings" Visibility="Collapsed" Margin="0,0,0,14">
                            <TextBlock Text="Tool-Pfad (z.B. realesrgan-ncnn-vulkan.exe):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtEsrganPath" Grid.Column="0" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Margin="0,0,3,0" TextChanged="Option_Changed"/>
                                <Button x:Name="BtnBrowseEsrgan" Grid.Column="1" Content="Suchen" Style="{StaticResource GlassButtonSecondary}" FontSize="10" Click="BtnBrowseEsrgan_Click"/>
                            </Grid>
                            <TextBlock Text="Modellname:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEsrganModel" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Text="realesrgan-x4plus-anime" TextChanged="Option_Changed"/>
                        </StackPanel>

                        <!-- Waifu2x -->
                        <StackPanel x:Name="PanelWaifu2xSettings" Visibility="Collapsed" Margin="0,0,0,14">
                            <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <TextBlock Text="✨ Waifu2x stellt Anime-Sprites mit gestochen scharfen Vektor-Kanten ohne Rauschen dar." FontSize="10" Foreground="{StaticResource BrushGlassPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Tool-Pfad (z.B. waifu2x-ncnn-vulkan.exe):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtWaifu2xPath" Grid.Column="0" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Margin="0,0,3,0" TextChanged="Option_Changed"/>
                                <Button x:Name="BtnBrowseWaifu2x" Grid.Column="1" Content="Suchen" Style="{StaticResource GlassButtonSecondary}" FontSize="10" Click="BtnBrowseWaifu2x_Click"/>
                            </Grid>
                            <TextBlock Text="AI-Modell:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbWaifu2xModel" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed"/>
                            <TextBlock Text="Entrauschung &amp; Glättung (Noise Level):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbWaifu2xNoise" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="-1 — Deaktiviert (Knackig scharfe Kanten)"/>
                                <ComboBoxItem Content=" 0 — Leichtes Entrauschen"/>
                                <ComboBoxItem Content=" 1 — Mittleres Entrauschen" IsSelected="True"/>
                                <ComboBoxItem Content=" 2 — Starkes Entrauschen"/>
                                <ComboBoxItem Content=" 3 — Maximum (Extrem seidenweich)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- RealCUGAN -->
                        <StackPanel x:Name="PanelRealCuganSettings" Visibility="Collapsed" Margin="0,0,0,14">
                            <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <TextBlock Text="✨ RealCUGAN erzeugt die samtigsten Farbverläufe und Vektorkanten für 2D-Anime-Sprites." FontSize="10" Foreground="{StaticResource BrushGlassPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Tool-Pfad (z.B. realcugan-ncnn-vulkan.exe):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtRealCuganPath" Grid.Column="0" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Margin="0,0,3,0" TextChanged="Option_Changed"/>
                                <Button x:Name="BtnBrowseRealCugan" Grid.Column="1" Content="Suchen" Style="{StaticResource GlassButtonSecondary}" FontSize="10" Click="BtnBrowseRealCugan_Click"/>
                            </Grid>
                            <TextBlock Text="RealCUGAN Modell:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbRealCuganModel" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="models-se (Schnell, knackig)" IsSelected="True"/>
                                <ComboBoxItem Content="models-pro (Höchste Qualität / Profi)"/>
                                <ComboBoxItem Content="models-nose (Keine Entrauschung)"/>
                            </ComboBox>
                            <TextBlock Text="Entrauschung &amp; Glättung:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbRealCuganDenoise" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="-1 — Deaktiviert (Knackige Kanten)" IsSelected="True"/>
                                <ComboBoxItem Content=" 0 — Leichtes Entrauschen"/>
                                <ComboBoxItem Content=" 1 — Mittleres Entrauschen"/>
                                <ComboBoxItem Content=" 2 — Starkes Entrauschen"/>
                                <ComboBoxItem Content=" 3 — Maximum (Sehr seidenweich)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- AI-First -->
                        <StackPanel x:Name="PanelAiFirstSettings" Visibility="Collapsed" Margin="0,0,0,14">
                            <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <TextBlock Text="🚀 AI-First Pipeline: 1× AI Upscale 4x → High-Res Enhancement (Volumetric3D, Shadow, Highlight auf 4× Auflösung) → Final Polish. Beste 3D-Optik durch 16× mehr Distance-Field-Pixel!" FontSize="10" Foreground="{StaticResource BrushGlassPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <CheckBox x:Name="ChkProgressiveMode" Content="Progressive Mode (AI 2x → Shade → AI 2x für extreme Upscales)" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,8"/>
                            <TextBlock Text="Primäres AI-Modell:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbAiModel" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="Auto (Waifu2x → RealCUGAN → XBRZ)" IsSelected="True"/>
                                <ComboBoxItem Content="Waifu2x only"/>
                                <ComboBoxItem Content="RealCUGAN only"/>
                                <ComboBoxItem Content="XBRZ only (offline, keine AI)"/>
                            </ComboBox>
                            <TextBlock Text="Fallback-Modell:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbAiFallbackModel" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="XBRZ (algorithmic fallback)" IsSelected="True"/>
                                <ComboBoxItem Content="Waifu2x"/>
                                <ComboBoxItem Content="RealCUGAN"/>
                            </ComboBox>
                            <TextBlock Text="Waifu2x Modell-Variante:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbWaifuModelVariant" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="Anime (Sprites, best for RO)" IsSelected="True"/>
                                <ComboBoxItem Content="Photo"/>
                                <ComboBoxItem Content="General (balanced)"/>
                            </ComboBox>
                            <TextBlock Text="RealCUGAN Entrauschung:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbRealCuganDenoiseLevel" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="0 — Keine Entrauschung" IsSelected="True"/>
                                <ComboBoxItem Content="1 — Leichtes Entrauschen"/>
                                <ComboBoxItem Content="2 — Mittleres Entrauschen"/>
                                <ComboBoxItem Content="3 — Starkes Entrauschen"/>
                            </ComboBox>
                            <TextBlock Text="Ziel-Breite (0 = auto 4x):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,8,0,3"/>
                            <TextBox x:Name="TxtTargetWidth" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Text="0" TextChanged="Option_Changed" Margin="0,0,0,4"/>
                            <TextBlock Text="Ziel-Höhe (0 = auto 4x):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,8,0,3"/>
                            <TextBox x:Name="TxtTargetHeight" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Text="0" TextChanged="Option_Changed" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkAiLogging" Content="AI-Execution Logging aktivieren (Console Output)" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                            <CheckBox x:Name="ChkAiSuperSampler" Content="SuperSampler Pre-Filter (schärfere Kanten vor AI-Upscale)" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- RealESRGAN -->
                        <StackPanel x:Name="PanelRealESRGANSettings" Visibility="Collapsed" Margin="0,0,0,14">
                            <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <TextBlock Text="🧠 RealESRGAN nutzt das x4plus-anime Modell für beste Anime-Sprite-Qualität mit Detail-Erhaltung." FontSize="10" Foreground="{StaticResource BrushGlassPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Tool-Pfad (z.B. realesrgan-ncnn-vulkan.exe):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtRealESRGANPath" Grid.Column="0" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Margin="0,0,3,0" TextChanged="Option_Changed"/>
                                <Button x:Name="BtnBrowseRealESRGAN" Grid.Column="1" Content="Suchen" Style="{StaticResource GlassButtonSecondary}" FontSize="10" Click="BtnBrowseRealESRGAN_Click"/>
                            </Grid>
                            <TextBlock Text="Modellname:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtRealESRGANModel" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Text="realesrgan-x4plus-anime" TextChanged="Option_Changed"/>
                        </StackPanel>

                        <!-- GFPGAN -->
                        <StackPanel x:Name="PanelGFPGANSettings" Visibility="Collapsed" Margin="0,0,0,14">
                            <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                <TextBlock Text="👁️ GFPGAN stellt Gesichter und Haare in Sprites wieder her — ideal für Charakter-Porträts und Ornamente." FontSize="10" Foreground="{StaticResource BrushGlassPrimary}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="Tool-Pfad (z.B. gfpgan-ncnn-vulkan.exe):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGFGANPath" Grid.Column="0" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Margin="0,0,3,0" TextChanged="Option_Changed"/>
                                <Button x:Name="BtnBrowseGFPGAN" Grid.Column="1" Content="Suchen" Style="{StaticResource GlassButtonSecondary}" FontSize="10" Click="BtnBrowseGFPGAN_Click"/>
                            </Grid>
                            <TextBlock Text="Modelldatei:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtGFGANModel" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Text="GFPGANv1.3.pth" TextChanged="Option_Changed"/>
                        </StackPanel>

                        <!-- SUPER-SAMPLER -->
                        <TextBlock Text="🎯 SUPER-SAMPLER (SSAA)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,6">
                                    <Run Text="4x Nearest → Shading → Downscale"/>
                                    <LineBreak/>
                                    <Run Text="→ natürliches Anti-Aliasing"/>
                                </TextBlock>
                                <CheckBox x:Name="ChkSsaa" Content="SSAA aktivieren" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="ChkSsaa_Changed" Unchecked="ChkSsaa_Changed"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="SsaaOptions" Visibility="Collapsed" Margin="0,0,0,6">
                            <TextBlock Text="Downscale-Filter:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbSsaaFilter" Style="{StaticResource GlassComboBox}" Margin="0,0,0,6" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="Lanczos3  (schärfste Kanten)" IsSelected="True"/>
                                <ComboBoxItem Content="Bicubic   (weich, kein Ringing)"/>
                                <ComboBoxItem Content="Bilinear  (schnell)"/>
                            </ComboBox>
                            <TextBlock Text="Ausgabegröße:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbSsaaSize" Style="{StaticResource GlassComboBox}" Margin="0,0,0,6" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="2x  (doppelte Größe)" IsSelected="True"/>
                                <ComboBoxItem Content="Original  (gleiche Größe)"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: PIXEL-SHADING &amp; EFFEKTE -->
            <TabItem Header="✨ Pixel-Shading &amp; Effekte">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel Margin="14,14,14,14">

                        <!-- PIXEL-SHADING -->
                        <TextBlock Text="✨ PIXEL-SHADING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkOutline" Content="Outline-Verstärkung" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="ChkShadow" Content="Drop-Shadow" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="ChkHighlight" Content="Highlight-Boost" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="ChkSharpen" Content="Nachschärfung" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="ChkVolumetric3D" Content="🧊 Plastischer 3D-Körpereffekt" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <TextBlock Text="Outline-Stärke:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,8,0,3"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrOutlineStrength" Minimum="0.1" Maximum="1.0" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Background="{StaticResource BrushGlassBorder}" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtOutlineVal" Text="0.5" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <ComboBox x:Name="CmbOutlineMode" Style="{StaticResource GlassComboBox}" Margin="0,0,0,8" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="Voll (Außenrand + interne Kanten)" IsSelected="True"/>
                            <ComboBoxItem Content="Nur intern (für Waffen/Kopfschmuck-Layer)"/>
                        </ComboBox>

                        <TextBlock Text="Highlight-Stärke:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrHighlightStrength" Minimum="0.1" Maximum="2.0" Value="0.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Background="{StaticResource BrushGlassBorder}" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtHighlightVal" Text="0.0" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Shadow-Stärke:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrShadowStrength" Minimum="0.1" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Background="{StaticResource BrushGlassBorder}" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtShadowVal" Text="1.0" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Schärfe-Stärke:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrSharpenStrength" Minimum="0.1" Maximum="1.0" Value="0.3" TickFrequency="0.1" IsSnapToTickEnabled="True" Background="{StaticResource BrushGlassBorder}" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSharpenVal" Text="0.3" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Text="Volumetric 3D-Stärke:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrVolumetric3DStrength" Minimum="0.1" Maximum="2.0" Value="0.75" TickFrequency="0.1" IsSnapToTickEnabled="True" Background="{StaticResource BrushGlassBorder}" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtVolumetricVal" Text="0.75" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>

                        <!-- FARBTON-VARIANTE -->
                        <TextBlock Text="🎨 FARBTON-VARIANTE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <TextBlock Text="Farbton-Verschiebung (Grad):" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrHueShift" Minimum="-180" Maximum="180" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtHueShiftVal" Text="0°" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Sättigung:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrSaturation" Minimum="0.0" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSaturationVal" Text="1.0" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Helligkeit:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" Margin="0,0,0,14"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                            <Slider x:Name="SldrLightness" Minimum="0.3" Maximum="1.7" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Option_Changed"/>
                            <TextBlock Grid.Column="1" x:Name="TxtLightnessVal" Text="1.0" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator/>

                        <!-- AUSSCHLUSS-BEREICH -->
                        <TextBlock Text="🔒 AUSSCHLUSS-BEREICH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkExclusionColor" Content="Bereiche mit dieser Farbe unverändert lassen" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ARGB Hex:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="TxtExclusionColor" Background="{StaticResource BrushGlassSurfaceLight}" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="5,3" FontSize="10" FontFamily="Consolas" Text="FF00FFFF" TextChanged="Option_Changed"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: KATEGORIEN -->
            <TabItem Header="🏷 Kategorien">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel Margin="14,14,14,14">

                        <TextBlock Text="🏷 KATEGORIE-EINSTELLUNGEN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkCategoryOverridesEnabled" Content="Pro-Kategorie-Einstellungen aktivieren" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <ComboBox x:Name="CmbCategoryPicker" Style="{StaticResource GlassComboBox}" DisplayMemberPath="Label" Margin="0,0,0,6" SelectionChanged="CmbCategoryPicker_SelectionChanged"/>
                        <CheckBox x:Name="ChkCategoryOverrideActive" Content="Eigene Werte für diese Kategorie" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="ChkCategoryOverrideActive_Changed" Unchecked="ChkCategoryOverrideActive_Changed" Margin="0,0,0,8"/>

                        <StackPanel x:Name="PanelCategorySliders" IsEnabled="False">
                            <CheckBox x:Name="ChkCatOutline" Content="Outline" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="CategorySetting_Changed" Unchecked="CategorySetting_Changed"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SldrCatOutline" Minimum="0.1" Maximum="1.0" Value="0.5" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="CategorySetting_Changed"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCatOutlineVal" Text="0.5" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="ChkCatShadow" Content="Shadow" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="CategorySetting_Changed" Unchecked="CategorySetting_Changed"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SldrCatShadow" Minimum="0.1" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="CategorySetting_Changed"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCatShadowVal" Text="1.0" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="ChkCatHighlight" Content="Highlight" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="CategorySetting_Changed" Unchecked="CategorySetting_Changed"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SldrCatHighlight" Minimum="0.1" Maximum="2.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="CategorySetting_Changed"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCatHighlightVal" Text="1.0" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="ChkCatSharpen" Content="Sharpen" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="CategorySetting_Changed" Unchecked="CategorySetting_Changed"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SldrCatSharpen" Minimum="0.1" Maximum="1.0" Value="0.3" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="CategorySetting_Changed"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCatSharpenVal" Text="0.3" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <CheckBox x:Name="ChkCatVolumetric3D" Content="Volumetric 3D" Style="{StaticResource GlassCheckBox}" IsChecked="False" Checked="CategorySetting_Changed" Unchecked="CategorySetting_Changed"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <Slider x:Name="SldrCatVolumetric3D" Minimum="0.1" Maximum="2.0" Value="0.75" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="CategorySetting_Changed"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCatVolumetricVal" Text="0.75" FontSize="10" Foreground="{StaticResource BrushGlassTextMedium}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: ANIMATION -->
            <TabItem Header="🎬 Animation">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <StackPanel Margin="14,14,14,14">

                        <TextBlock Text="🎯 ANIMATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkScaleActAnchors" Content="ACT-Anker mitskalieren (Empfohlen)" Style="{StaticResource GlassCheckBox}" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <Border Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Hinweis:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="Beim Skalieren von .spr-Dateien wird die zugehörige .act-Datei bei aktivierter Option proportional angepasst, damit Sprite-Ankerpunkte nicht verrutschen." FontSize="10" Foreground="{StaticResource BrushGlassTextDark}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- BUTTONS -->
        <Border Grid.Row="1" Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Änderungen werden beim Schließen mit OK übernommen." FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                <Button x:Name="BtnOk" Grid.Column="1" Content="OK" Style="{StaticResource GlassButtonPrimary}" Width="80" Height="32" Margin="12,0,8,0" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" Grid.Column="2" Content="Abbrechen" Style="{StaticResource GlassButtonSecondary}" Width="100" Height="32" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnApply" Grid.Column="3" Content="Übernehmen" Style="{StaticResource GlassButtonSecondary}" Width="100" Height="32" Click="BtnApply_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>