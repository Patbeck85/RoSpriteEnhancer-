<Window x:Class="RoSpriteEnhancer.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RO Sprite Enhancer v1.21 — Liquid Glass 2026"
        Height="860" Width="1400"
        MinHeight="720" MinWidth="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushGlassBackground}"
        FontFamily="Segoe UI Variable"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter"
        DragLeave="Window_DragLeave"
        Style="{StaticResource GlassWindow}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushGlassTextDark}"/>
        </Style>
        <Style TargetType="Separator" BasedOn="{StaticResource GlassSeparator}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="84"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR — Glass -->
        <Border Grid.Row="0" Background="{StaticResource BrushGlassSurfaceLight}"
                BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚔" FontSize="24" Margin="0,0,12,0" Foreground="{StaticResource BrushGlassPrimary}"/>
                    <TextBlock Text="RO Sprite Enhancer" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource BrushGlassTextDark}"/>
                    <TextBlock Text=" v1.21" FontSize="14" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                    <TextBlock Text="  ·  Liquid Glass 2026  ·  GPU-frei  ·  Scale2x  ·  Waifu2x AI  ·  RealCUGAN"
                               FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Button x:Name="BtnSettings" Content="⚙ Einstellungen" Style="{StaticResource GlassButtonSecondary}" FontSize="12" Padding="14,8" Margin="0,0,20,0" Click="BtnSettings_Click"/>
                    <TextBlock x:Name="TxtStatus" Text="Bereit" FontSize="12" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Border x:Name="DropIndicator" Background="{StaticResource BrushGlassSuccess}" BorderBrush="{StaticResource BrushGlassSuccess}" BorderThickness="1" CornerRadius="8" Padding="10,4" Visibility="Collapsed">
                        <TextBlock Text="📂  Datei loslassen..." FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SETTINGS SHORTCUT BAR — Glass -->
        <Border Grid.Row="1" Background="{StaticResource BrushGlassSurfaceLight}"
                BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="20,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Eingabe:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtInputPath" Background="Transparent" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="10,8" FontSize="11" FontFamily="Consolas" IsReadOnly="True" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Ausgabe:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Grid.Column="3" x:Name="TxtOutputPath" Background="Transparent" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="10,8" FontSize="11" FontFamily="Consolas" IsReadOnly="True" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Skalierung:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <ComboBox Grid.Column="5" x:Name="CmbScale" Style="{StaticResource GlassComboBox}" Margin="6,0,0,0" Width="150" VerticalAlignment="Center">
                    <ComboBoxItem Content="Scale2x" IsSelected="True"/>
                    <ComboBoxItem Content="xBRZ 2x"/>
                    <ComboBoxItem Content="Waifu2x"/>
                    <ComboBoxItem Content="RealCUGAN"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- TOOL PATHS SHORTCUT BAR — Glass -->
        <Border Grid.Row="2" Background="{StaticResource BrushGlassSurfaceLight}"
                BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="20,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Waifu2x:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Grid.Row="0" x:Name="TxtWaifu2xPath" Background="Transparent" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="10,8" FontSize="11" FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Grid.Row="0" Text="RealCUGAN:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox Grid.Column="3" Grid.Row="0" x:Name="TxtRealCuganPath" Background="Transparent" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="10,8" FontSize="11" FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="RealESRGAN:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Grid.Row="1" x:Name="TxtRealESRGANPath" Background="Transparent" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="10,8" FontSize="11" FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Grid.Row="1" Text="GFPGAN:" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                        <TextBox Grid.Column="3" Grid.Row="1" x:Name="TxtGFGANPath" Background="Transparent" Foreground="{StaticResource BrushGlassTextDark}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" Padding="10,8" FontSize="11" FontFamily="Consolas" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
        </Border>

        <!-- GRF WORKFLOW PANEL — Glass Card -->
        <Border Grid.Row="4" Style="{StaticResource GlassCard}" Margin="20,10,20,4">
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="GRF:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushGlassPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource BrushGlassSurfaceMedium}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="10" Margin="0,4,12,4">
                    <TextBlock x:Name="TxtGrfPath" Text="— keine GRF geöffnet —" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource BrushGlassTextLight}" Padding="10,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button Grid.Column="2" x:Name="BtnGrfOpen" Content="📂  GRF öffnen" Style="{StaticResource GlassButtonSecondary}" FontSize="11" Padding="14,6" Margin="0,4,8,4" Click="BtnGrfOpen_Click"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtGrfStep1" Text="①" FontSize="14" Foreground="{StaticResource BrushGlassPrimary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="→" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtGrfStep2" Text="②" FontSize="14" Foreground="{StaticResource BrushGlassPrimary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="→" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtGrfStep3" Text="③" FontSize="14" Foreground="{StaticResource BrushGlassPrimary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="→" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtGrfStep4" Text="④" FontSize="14" Foreground="{StaticResource BrushGlassPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="4" x:Name="BtnGrfExtract" Content="📤  Sprites extrahieren" Style="{StaticResource GlassButtonSecondary}" FontSize="11" Padding="14,6" Margin="0,4,8,4" IsEnabled="False" Click="BtnGrfExtract_Click"/>
                <Button Grid.Column="5" x:Name="BtnGrfPack" Content="📦  Zurück in GRF packen" Style="{StaticResource GlassButtonSecondary}" FontSize="11" Padding="14,6" Margin="0,4,8,4" IsEnabled="False" Click="BtnGrfPack_Click"/>

                <Border Grid.Column="6" x:Name="GrfInfoBadge" Background="{StaticResource BrushGlassSuccess}" BorderBrush="{StaticResource BrushGlassSuccess}" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,4,0,4" Visibility="Collapsed">
                    <TextBlock x:Name="TxtGrfInfo" Text="" FontSize="10" Foreground="White" FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>

        <!-- GRF FILTER PANEL — Glass Card -->
        <Border Grid.Row="4" x:Name="GrfFilterPanel" Style="{StaticResource GlassCardFlat}" Margin="20,4,20,10" Visibility="Collapsed">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="KATEGORIEN FILTERN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGlassPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtFilterSummary" Text="Alle Kategorien" FontSize="11" Foreground="{StaticResource BrushGlassTextLight}" FontFamily="Consolas"/>
                                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <WrapPanel x:Name="CategoryPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="ChkCustomGrfFilter" Content="📂 Custom / Eigener Pfad:" Style="{StaticResource GlassCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0" Checked="CatCheckbox_Changed" Unchecked="CatCheckbox_Changed"/>
                        <TextBox x:Name="TxtCustomGrfPath" Width="240" Style="{StaticResource GlassTextBox}" FontSize="10" Text="data\sprite\custom\" TextChanged="Option_Changed" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="Alle" Style="{StaticResource GlassButtonGhost}" FontSize="11" Padding="10,4" Margin="0,0,0,4" Click="BtnCatAll_Click"/>
                    <Button Content="Keine" Style="{StaticResource GlassButtonGhost}" FontSize="11" Padding="10,4" Click="BtnCatNone_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GRF PROGRESS PANEL — Glass Card -->
        <Border Grid.Row="5" x:Name="GrfProgressPanel" Style="{StaticResource GlassCardFlat}" Margin="20,4,20,10" Visibility="Collapsed">
            <Grid Margin="20,12,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" x:Name="GrfOpBadge" Background="{StaticResource BrushGlassPrimary}" BorderBrush="{StaticResource BrushGlassPrimary}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,12,0">
                        <TextBlock x:Name="TxtGrfOpLabel" Text="GRF" FontSize="10" FontWeight="Bold" Foreground="White" FontFamily="Consolas"/>
                    </Border>

                    <TextBlock Grid.Column="1" x:Name="TxtGrfCurrentFile" Text="Warte..." FontSize="11" Foreground="{StaticResource BrushGlassTextDark}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <Border Grid.Column="2" Background="{StaticResource BrushGlassSurfaceMedium}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="10" Foreground="{StaticResource BrushGlassSuccess}"/>
                            <TextBlock x:Name="TxtGrfSpeed" Text="—" FontSize="10" Foreground="{StaticResource BrushGlassSuccess}" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{StaticResource BrushGlassSurfaceMedium}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " FontSize="10" Foreground="{StaticResource BrushGlassTextLight}"/>
                            <TextBlock x:Name="TxtGrfEta" Text="—" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource BrushGlassSurfaceMedium}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtGrfCounter" Text="0 / 0" FontSize="10" Foreground="{StaticResource BrushGlassTextDark}" FontFamily="Consolas"/>
                    </Border>

                    <Button Grid.Column="5" Content="✕" Style="{StaticResource GlassButtonGhost}" Padding="10,4" FontSize="12" Margin="12,0,0,0" Click="BtnGrfCancel_Click"/>
                </Grid>

                <Grid Grid.Row="1">
                    <ProgressBar x:Name="PrgGrf" Height="6" Minimum="0" Maximum="100" Value="0" Style="{StaticResource GlassProgressBar}"/>
                </Grid>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtGrfStatus" Text="" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" x:Name="TxtGrfElapsed" Text="" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" FontFamily="Consolas"/>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- VORSCHAU SPALTE -->
            <Grid Grid.Column="0" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,0,0,1" CornerRadius="12,12,0,0">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="VORSCHAU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource BrushGlassPrimary}" CornerRadius="6" Padding="8,2" Margin="14,0,0,0">
                                <TextBlock x:Name="TxtPreviewFile" Text="— keine Datei —" FontSize="11" Foreground="White" FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="SprBadge" Background="{StaticResource BrushGlassSuccess}" BorderBrush="{StaticResource BrushGlassSuccess}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TxtSprInfo" Text="SPR · 0 Frames" FontSize="10" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Ansicht:" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnViewList" Content="☰ Liste" Style="{StaticResource GlassButtonGhost}" FontSize="11" Padding="10,4" Margin="0,0,4,0" Click="BtnViewList_Click"/>
                            <Button x:Name="BtnViewGrid" Content="⊞ Raster" Style="{StaticResource GlassButtonGhost}" FontSize="11" Padding="10,4" Margin="0,0,4,0" Click="BtnViewGrid_Click"/>
                            <Button x:Name="BtnViewContact" Content="◐ Kontaktbogen" Style="{StaticResource GlassButtonGhost}" FontSize="11" Padding="10,4" Margin="0,0,16,0" Click="BtnViewContact_Click"/>
                            <TextBlock Text="◄ VORHER" FontSize="10" Foreground="{StaticResource BrushGlassError}" VerticalAlignment="Center"/>
                            <TextBlock Text="  ───  " FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center"/>
                            <TextBlock Text="NACHHER ►" FontSize="10" Foreground="{StaticResource BrushGlassSuccess}" VerticalAlignment="Center"/>
                            <ToggleButton x:Name="BtnSideBySide" Content="▌▌ Vergleich" Style="{StaticResource GlassButtonGhost}" FontSize="10" Padding="8,4" Margin="12,0,0,0" VerticalAlignment="Center" Click="BtnSideBySide_Click" ToolTip="Seitenweise Vergleich (Original ↔ Verarbeitet)"/>
                        <ToggleButton x:Name="BtnAiComparison" Style="{StaticResource GlassButtonGhost}" FontSize="10" Padding="8,4" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnAiComparison_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <Grid x:Name="PreviewContainer" HorizontalAlignment="Center" VerticalAlignment="Center" MouseWheel="PreviewContainer_MouseWheel" MouseLeftButtonDown="PreviewContainer_MouseLeftButtonDown" MouseMove="PreviewContainer_MouseMove" MouseLeftButtonUp="PreviewContainer_MouseLeftButtonUp">
                        <Border x:Name="CheckerBg" Width="600" Height="500">
                            <Border.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#E8F1FF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
                                            <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8"/><RectangleGeometry Rect="8,8,8,8"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                        </Border>

                        <Grid x:Name="ZoomTarget" Width="600" Height="500">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" CenterX="300" CenterY="250"/>
                                    <TranslateTransform x:Name="PanTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Image x:Name="ImgBefore" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="ImgAfter" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Line x:Name="DividerLine" Stroke="{StaticResource BrushGlassError}" StrokeThickness="1.5" X1="300" X2="300" Y1="0" Y2="500"/>

                            <StackPanel x:Name="NoFileHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚔" FontSize="56" Foreground="#E8F1FF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Sprite auswählen oder Datei hierher ziehen" FontSize="14" Foreground="{StaticResource BrushGlassTextLight}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="BMP · PNG · TGA · SPR" FontSize="11" Foreground="#B8D4F0" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer Grid.Row="1" x:Name="GridViewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="Transparent" Visibility="Collapsed">
                    <WrapPanel x:Name="ThumbPanel" Margin="12" Orientation="Horizontal"/>
                </ScrollViewer>

                <Border Grid.Row="4" Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,1,0,0">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="−" Style="{StaticResource GlassButtonGhost}" Padding="10,4" FontSize="14" Click="BtnZoomOut_Click" Margin="0,0,4,0"/>
                            <Border Background="{StaticResource BrushGlassSurfaceMedium}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="0,0,4,0">
                                <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="11" Foreground="{StaticResource BrushGlassTextDark}" VerticalAlignment="Center" Width="36" TextAlignment="Center"/>
                            </Border>
                            <Button Content="+" Style="{StaticResource GlassButtonGhost}" Padding="10,4" FontSize="14" Click="BtnZoomIn_Click" Margin="0,0,4,0"/>
                            <Button Content="⊡" Style="{StaticResource GlassButtonGhost}" Padding="8,4" FontSize="12" Click="BtnZoomReset_Click"/>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="14,0">
                            <TextBlock Text="◄ VORHER" FontSize="10" Foreground="{StaticResource BrushGlassError}" VerticalAlignment="Center"/>
                            <Slider x:Name="SldrPreview" Minimum="0" Maximum="1" Value="0.5" VerticalAlignment="Center" Margin="80,0" ValueChanged="SldrPreview_ValueChanged" Style="{StaticResource GlassSlider}"/>
                            <TextBlock Text="NACHHER ►" FontSize="10" Foreground="{StaticResource BrushGlassSuccess}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock Grid.Column="2" x:Name="TxtPixelInfo" Text="" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="5" x:Name="AnimBar" Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <Grid Margin="14,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnAnimPlay" Content="▶" Style="{StaticResource GlassButtonSecondary}" Padding="12,4" FontSize="13" Click="BtnAnimPlay_Click" Margin="0,0,5,0"/>
                            <Button x:Name="BtnAnimStop" Content="■" Style="{StaticResource GlassButtonSecondary}" Padding="12,4" FontSize="13" Click="BtnAnimStop_Click" Margin="0,0,12,0" IsEnabled="False"/>
                            <TextBlock Text="FPS:" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbAnimFps" Style="{StaticResource GlassComboBox}" Width="72" Padding="6,4" FontSize="11" SelectionChanged="CmbAnimFps_SelectionChanged">
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="15" IsSelected="True"/>
                                <ComboBoxItem Content="24"/>
                                <ComboBoxItem Content="30"/>
                            </ComboBox>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="14,0">
                            <Slider x:Name="SldrFrame" Minimum="0" Maximum="0" Value="0" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="SldrFrame_ValueChanged" Style="{StaticResource GlassSlider}"/>
                        </Grid>

                        <Border Grid.Column="2" Background="{StaticResource BrushGlassSurfaceMedium}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1" CornerRadius="8" Padding="10,2">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="TxtFrameCounter" Text="Frame 0 / 0" FontSize="11" Foreground="{StaticResource BrushGlassTextDark}" FontFamily="Consolas"/>
                                <CheckBox x:Name="ChkOnionSkin" Content="🧅 Onion Skin" Style="{StaticResource GlassCheckBox}" FontSize="9" Margin="0,4,0,0" IsChecked="False" Checked="ChkOnionSkin_Checked" Unchecked="ChkOnionSkin_Unchecked"/>
                                <Slider x:Name="SldrOnionSkin" Minimum="0.1" Maximum="0.9" Value="0.3" IsEnabled="False" Style="{StaticResource GlassSlider}" Margin="0,2,0,0" ValueChanged="SldrOnionSkin_ValueChanged"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- DATEIEN SPALTE -->
            <Border Grid.Column="2" Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1,0,0,0" CornerRadius="0,16,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushGlassPrimary}" CornerRadius="0,12,0,0">
                        <Grid Margin="16,0">
                            <TextBlock Text="DATEIEN" FontSize="10" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFileCount" Text="0 Dateien" FontSize="10" Foreground="#E8F1FF" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LstFiles" Grid.Row="1" Style="{StaticResource GlassListBox}" SelectionChanged="LstFiles_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,1">
                                    <TextBlock Text="✓ " Foreground="{StaticResource BrushGlassSuccess}" FontSize="10" Visibility="{Binding DoneVisibility}"/>
                                    <TextBlock Text="{Binding FileName}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="170" ToolTip="{Binding FilePath}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" Padding="14,10" Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button Content="📂  Ordner laden" Style="{StaticResource GlassButtonSecondary}" Margin="0,0,0,6" Click="BtnBrowseInput_Click" FontSize="11"/>
                            <Button Content="🔍  Vorschau aktualisieren" Style="{StaticResource GlassButtonSecondary}" Click="BtnRefreshPreview_Click" FontSize="11"/>
                            <Button Content="🖼  Sprite Atlas erstellen" Style="{StaticResource GlassButtonSecondary}" Margin="0,6,0,0" Click="BtnCreateSpriteAtlas_Click" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM BAR — Glass -->
        <Border Grid.Row="7" Background="{StaticResource BrushGlassSurfaceLight}" BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="TxtProgress" Text="Bereit — Ordner wählen oder Datei hineinziehen" FontSize="11" Foreground="{StaticResource BrushGlassTextDark}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtProgressDetail" Text="" FontSize="11" Foreground="{StaticResource BrushGlassPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtThroughput" Text="" FontSize="10" Foreground="{StaticResource BrushGlassTextLight}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <ProgressBar x:Name="PrgBatch" Height="7" Minimum="0" Maximum="100" Value="0" Background="#E8F1FF" BorderThickness="0">
                        <ProgressBar.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{StaticResource GlassPrimaryLight}" Offset="0"/>
                                <GradientStop Color="{StaticResource GlassPrimaryDark}" Offset="1"/>
                            </LinearGradientBrush>
                        </ProgressBar.Foreground>
                    </ProgressBar>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button x:Name="BtnStop" Content="■  Stopp" Style="{StaticResource GlassButtonSecondary}" Margin="0,0,12,0" Click="BtnStop_Click" IsEnabled="False"/>
                    <Button x:Name="BtnProcess" Content="▶  BATCH STARTEN" Style="{StaticResource GlassButtonPrimary}" Width="220" Height="48" Click="BtnProcess_Click"/>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Window>